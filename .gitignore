# Node
node_modules/
.next/
.turbo/
*.tsbuildinfo

# Environment files (never commit real .env)
.env*
.env
.env.local
.env.*

# Python
__pycache__/
*.pyc
.pycache/
*.egg-info/

# Virtual environments (never commit)
.venv/
venv/
ENV/
env/
virtualenv/

# Caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.htmlcov/

# Distribution / build artifacts
dist/
build/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.~lock.*#

# Jupyter Notebook
.ipynb_checkpoints/

# Sensitive credentials
*.json.key
service-account*.json
*credentials*.json
*service-account*.json
*-key.json
key.json
*.pem
*.recovered

# GitHub internal guidance (not source)
.github/instructions/

# Output and logs generated at runtime
output/
logs/

# Keep the graph data and report in version control; ignore local graphify caches
# and generated visualization/tool metadata.
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/manifest.json
graphify-out/graph.html
graphify-out/20??-??-??/

# User configuration
config/*.yaml
!config/*.example.yaml
# These non-secret runtime configs are required by the scheduled GitHub Actions job.
# Keep them visible to Git so they can be reviewed and committed as documented in
# docs/PHASE6.md. Optional settings.yaml remains local because the app has defaults.
!config/sources.yaml
!config/profile.yaml
!config/scoring.yaml
!config/profiles.yaml

# Template file - kept in git for reference
!.env.example
